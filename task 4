<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Class Timetable</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
        }

        h2 {
            text-align: center;
            color: darkblue;
        }

        table {
            margin: auto;
            border-collapse: separate;
            border-spacing: 5px; /* Cell Spacing */
        }

        th, td {
            border: 2px solid black;
            padding: 15px; /* Cell Padding */
            text-align: center;
            font-weight: bold;
        }

        th {
            background-color: #333;
            color: white;
        }

        .english {
            background-color: #FFD700;
        }

        .maths {
            background-color: #90EE90;
        }

        .science {
            background-color: #87CEEB;
        }

        .computer {
            background-color: #FFA07A;
        }

        .social {
            background-color: #DDA0DD;
        }

        .tamil {
            background-color: #FFB6C1;
        }

        .lunch {
            background-color: #D3D3D3;
        }

        .sports {
            background-color: #98FB98;
        }
    </style>
</head>

<body>

<h2>Class Timetable</h2>

<table>

    <tr>
        <th>Day</th>
        <th>9:00-10:00</th>
        <th>10:00-11:00</th>
        <th>11:00-12:00</th>
        <th>12:00-1:00</th>
        <th>1:00-2:00</th>
        <th>2:00-3:00</th>
        <th>3:00-4:00</th>
    </tr>

    <tr>
        <td><b>Monday</b></td>
        <td class="english">English</td>
        <td class="maths">Maths</td>
        <td class="science">Science</td>

        <!-- Rowspan -->
        <td class="lunch" rowspan="5">LUNCH</td>

        <td class="computer">Computer</td>
        <td class="social">Social</td>
        <td class="sports">Sports</td>
    </tr>

    <tr>
        <td><b>Tuesday</b></td>
        <td class="maths">Maths</td>
        <td class="science">Science</td>
        <td class="english">English</td>
        <td class="tamil">Tamil</td>
        <td class="computer">Computer</td>
        <td class="sports">Sports</td>
    </tr>

    <tr>
        <td><b>Wednesday</b></td>

        <!-- Colspan -->
        <td class="computer" colspan="2">Computer Lab</td>

        <td class="maths">Maths</td>
        <td class="science">Science</td>
        <td class="english">English</td>
        <td class="social">Social</td>
    </tr>

    <tr>
        <td><b>Thursday</b></td>
        <td class="science">Science</td>
        <td class="social">Social</td>
        <td class="maths">Maths</td>
        <td class="english">English</td>
        <td class="computer">Computer</td>
        <td class="tamil">Tamil</td>
    </tr>

    <tr>
        <td><b>Friday</b></td>
        <td class="tamil">Tamil</td>
        <td class="english">English</td>

        <!-- Colspan -->
        <td class="sports" colspan="2">Games / Physical Education</td>

        <td class="science">Science</td>
        <td class="maths">Maths</td>
    </tr>

</table>

</body>
</html>
